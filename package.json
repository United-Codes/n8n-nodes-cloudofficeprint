{
	"name": "n8n-nodes-cloudofficeprint",
	"version": "0.2.1",
	"description": "CloudOfficePrint nodes for n8n",
	"license": "MIT",
	"homepage": "https://github.com/United-Codes/n8n-nodes-cloudofficeprint",
	"keywords": [
		"n8n-community-node-package",
		"cloudofficeprint",
		"apex-office-print",
		"pdf",
		"document-generation",
		"document-automation"
	],
	"author": {
		"name": "CloudOfficePrint",
		"email": "support@cloudofficeprint.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/United-Codes/n8n-nodes-cloudofficeprint.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "vitest run",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/CloudOfficePrintApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/CloudOfficePrint/CloudOfficePrint.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.41.2",
		"@types/node": "^25.0.9",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^19.0.4",
		"typescript": "5.9.2",
		"vitest": "^4.1.10"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"packageManager": "pnpm@10.28.0+sha512.05df71d1421f21399e053fde567cea34d446fa02c76571441bfc1c7956e98e363088982d940465fd34480d4d90a0668bc12362f8aa88000a64e83d0b0e47be48"
}
