      "name": "Look up counterparty in CRM"
    },
    {
      "parameters": {
        "jsCode": "const form = $('Start a contract review').first();\nconst answers = form.json;\nconst files = form.binary ?? {};\n// the CRM returns an empty list when it doesn't know the email\nconst contact = $input.first().json.users?.[0];\n\nreturn [{\n  json: {\n    contract_name: answers.contract_name,\n    requested_by: answers.requested_by,\n    due_date: DateTime.fromISO(answers.due_date).toFormat('MMMM d, yyyy'),\n    created_on: $now.toFormat('MMMM d, yyyy'),\n    previous_file: files.previous_version?.fileName ?? '',\n    revised_file: files.revised_version?.fileName ?? '',\n    counterparty_name: contact ? `${contact.firstName} ${contact.lastName}` : 'Not found in CRM',\n    counterparty_title: contact?.company?.title ?? '',\n    counterparty_company: contact?.company?.name ?? '',\n    counterparty_email: answers.counterparty_email,\n    counterparty_phone: contact?.phone ?? '',\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        416
      ],
      "id": "b7eb73cc-18b6-483f-9ebf-5787fe38d432",
      "name": "Prepare cover sheet"
    },
