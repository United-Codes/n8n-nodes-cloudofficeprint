              "fieldName": "requested_by",
              "requiredField": true
            }
          ]
        },
        "options": {
          "buttonLabel": "Create review pack",
          "respondWithOptions": {
            "values": {
              "formSubmittedText": "Thanks. The review pack will be in Google Drive in a minute."
            }
          }
        }
      },
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.6,
