        1456,
        112
      ],
      "id": "f95e5bf7-d80a-4432-95ab-0e1b1d5c64c9",
      "name": "Get products"
    },
    {
      "parameters": {
        "jsCode": "const settings = $('Slide settings').first().json;\nconst category = $('Choose a category').first().json.category;\nconst { products } = $input.first().json;\nconst money = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' });\nconst generatedOn = $now.toFormat('MMMM d, yyyy');\n\nreturn [{\n  json: {\n    company: settings.company,\n    sales_contact: settings.sales_contact,\n    category_title: category,\n    product_count: products.length,\n    generated_on: generatedOn,\n    products: products.map((p) => ({\n      title: p.title,\n      brand: p.brand ?? '',\n      price: money.format(p.price),\n      rating: p.rating.toFixed(1),\n      stock_label: p.stock > 0 ? `${p.stock} in stock` : 'Out of stock',\n      description: p.description,\n      category_title: category,\n      image: p.images?.[0] ?? p.thumbnail,\n      image_max_width: '400px',\n      image_max_height: '400px',\n    })),\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1696,
        112
      ],
      "id": "cf2ac4de-9444-4c2b-8682-1cda94b640d1",
      "name": "Prepare slides"
    },
