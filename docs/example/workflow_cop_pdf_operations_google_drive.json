    {
      "parameters": {
        "content": "## Watermark\n\nOperation PDF Watermark.\n\nBase64 Encoded File: `{{ $json.body }}`, taken straight from the previous Cloud Office Print node.\n\nText CONFIDENTIAL, colour `#D3D3D3`, opacity 50, size 45.\n\nThe text is stamped diagonally on every page.",
        "height": 425,
        "width": 260,
        "color": 2
